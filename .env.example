# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 GitHub에 올라가지 않는다.

# 화면과 API가 함께 쓰는 포트. 공용 서버에서 계정에 배정된 PORT가 이미 있으면 적지 않는다 (user05 → 3005)
# PORT=3005

# ── AI (OpenAI 호환 주소). 두 곳 중 값을 채운 곳을 쓴다. 둘 다 있으면 LLM_PROVIDER로 고른다 (local | openrouter)
# LLM_PROVIDER=local

# [맥미니 Ollama]
LLM_BASE_URL=https://<맥미니 주소>/v1
LLM_API_KEY=
LLM_MODEL=gemma4:12b
# Ollama일 때만: 한 번에 읽을 입력 크기(토큰). 없으면 Ollama 기본값(약 2,000)까지만 읽어 긴 입력이 잘림
LLM_NUM_CTX=16384

# [OpenRouter] 키 발급: https://openrouter.ai/keys, 무료 모델은 ID 끝이 :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── 관리 페이지(/admin) 비밀번호. 없으면 관리 페이지가 잠긴다 (검수 · AI 초안 · 직접 추가)
ADMIN_PASSWORD=

# 출제 자격 표에 서명하는 값 (아무 긴 글자). 없으면 서버를 다시 켤 때마다 이전 출제 자격이 무효가 된다
APP_SECRET=
